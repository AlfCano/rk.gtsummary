msgid "Summary Table (gtsummary)"
msgstr "Tableau de synthèse (gtsummary)"

msgid ""
"An RKWard plugin to generate summary tables using the 'gtsummary' package, "
"supporting both standard data.frames (tbl_summary) and survey design objects "
"(tbl_svysummary)."
msgstr ""
"Un plugin RKWard pour générer des tableaux de synthèse avec le paquet "
"'gtsummary', supportant les data.frames (tbl_summary) et les plans de "
"sondage (tbl_svysummary)."


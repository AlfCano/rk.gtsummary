msgid "Summary Table (tbl_summary)"
msgstr "Zusammenfassungstabelle (tbl_summary)"

msgid "Creates a descriptive summary table for a data frame using gtsummary::tbl_summary()."
msgstr "Erstellt eine deskriptive Zusammenfassungstabelle für einen Data Frame."

msgid "Select a data frame and the variables to include."
msgstr "Wählen Sie einen Data Frame und die einzuschließenden Variablen."

msgid "Key Arguments"
msgstr "Hauptargumente"

msgid "Use the tabs to customize statistics, formatting, themes, and handling of missing data. Use 'Outer stratification' to create grouped tables with <code>tbl_strata()</code>."
msgstr "Verwenden Sie die Reiter, um Statistiken, Formatierung und Themen anzupassen. Nutzen Sie 'Äußere Stratifizierung' für gruppierte Tabellen mit <code>tbl_strata()</code>."

msgid "Table of Summary Statistics"
msgstr "Tabelle der zusammenfassenden Statistiken"


msgid "Summary Table (gtsummary)"
msgstr "Tabla de Resumen (gtsummary)"

msgid ""
"An RKWard plugin to generate summary tables using the 'gtsummary' package, "
"supporting both standard data.frames (tbl_summary) and survey design objects "
"(tbl_svysummary)."
msgstr ""
"Un plugin de RKWard para generar tablas de resumen utilizando el paquete "
"'gtsummary', compatible con data.frames estándar (tbl_summary) y objetos de "
"diseño muestral (tbl_svysummary)."

